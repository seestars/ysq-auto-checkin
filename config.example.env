# 源社区签到 — 环境变量模板
# 复制为 .env 并填写，或在 GitHub Actions Secrets 中配置同名变量。
# 注意：.env 含敏感信息，切勿提交到公开仓库。

# ===== 登录凭证 =====

# 方式 A（推荐，免手动更新 Cookie）：账号密码自动登录
SRC_USERNAME=your_username
SRC_PASSWORD=your_password

# 若账号设置了安全提问（登录页下拉框 1-7），取消注释并填写
# SRC_QUESTION_ID=1
# SRC_ANSWER=答案

# 方式 B（可选）：Cookie 登录
# 浏览器登录 src.top → F12 → Network → 任意请求 → 复制 Cookie 头
# 必须包含 YPSa_2132_auth 与 YPSa_2132_saltkey
# SRC_COOKIE=YPSa_2132_auth=xxxx; YPSa_2132_saltkey=yyyy; YPSa_2132_lastvisit=...; YPSa_2132_sid=...

# 方式 C：Cookie 文件路径（Netscape cookies.txt 或原始 Cookie 头文件）
# SRC_COOKIE_FILE=./cookies.txt

# 同时配置 Cookie + 账密：Cookie 优先，过期自动回退账密登录（最稳）

# ===== Telegram 推送（可选）=====
# 签到结果推送到 Telegram，成功/失败都会通知
# Bot Token: 找 @BotFather 创建 bot 获取
# Chat ID: 给 bot 发条消息后访问 https://api.telegram.org/bot<TOKEN>/getUpdates 查看
# SRC_TG_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# SRC_TG_CHAT_ID=123456789

# ===== 可选配置 =====

# 站点地址，默认 https://src.top
# SRC_BASE_URL=https://src.top

# 请求超时（秒），默认 30
# SRC_TIMEOUT=30

# 网络重试次数，默认 3
# SRC_RETRIES=3

# 重试退避基数（秒），默认 2
# SRC_RETRY_BACKOFF=2

# 设为 1 时只登录取 formhash，不真正签到
# SRC_DRY_RUN=0

# 日志级别 DEBUG/INFO/WARNING，默认 INFO
# SRC_LOG_LEVEL=INFO

# 自定义 User-Agent
# SRC_USER_AGENT=Mozilla/5.0 ...
